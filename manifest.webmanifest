{
  "name": "Mindmap — freeform diagrams",
  "short_name": "Mindmap",
  "description": "Offline-first mind mapping. Independent diagrams in local .mindmap files.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f7fa",
  "theme_color": "#f6f7fa",
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/json": [
          ".mindmap",
          ".json"
        ]
      }
    }
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
