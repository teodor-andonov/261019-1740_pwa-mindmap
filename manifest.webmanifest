{
  "name": "TaMindmap",
  "short_name": "TaMindmap",
  "description": "Offline-first mind mapping. Independent diagrams in local .mindmap files.",
  "id": "/261019-1740_pwa-mindmap/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f7fa",
  "theme_color": "#f6f7fa",
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/json": [
          ".mindmap",
          ".json"
        ]
      }
    }
  ],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
